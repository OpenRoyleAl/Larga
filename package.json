{
  "name": "larga",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Larga — Cebu Ai Agent Cup. One CloudFlare deploy. Grid, Drive, Profile.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --experimental-strip-types --test packages/shared/src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:cup": "wrangler deploy --domains larga.openroyleal.com",
    "db": "wrangler d1 migrations apply larga --local",
    "db:remote": "wrangler d1 migrations apply larga"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260829.1",
    "typescript": "5.9.2",
    "wrangler": "4.127.1"
  }
}
