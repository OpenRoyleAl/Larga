{
  "name": "larga",
  "main": "packages/app/src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "larga",
      "database_id": "REPLACE_AFTER_CREATE",
      "migrations_dir": "packages/dex/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GRAPHS", "class_name": "GraphRoom" },
      { "name": "PRESENCE", "class_name": "Presence" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["GraphRoom", "Presence"]
    }
  ],
  "vars": {
    "CUP_NAME": "Cebu AI Agent Cup",
    "DRIVE_URL": "",
    "DEX_URL": "",
    "CERT_SECRET": "",
    "SERVICE_SECRET": ""
  }
}
