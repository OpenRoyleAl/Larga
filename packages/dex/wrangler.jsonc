{
  "name": "larga-dex",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "larga-dex",
      "database_id": "REPLACE_AFTER_CREATE"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }]
  },
  "migrations": [{ "tag": "v1", "new_classes": ["Presence"] }],
  "vars": {
    "CUP_NAME": "Cebu Ai Agent Cup",
    "CERT_SECRET": "",
    "SERVICE_SECRET": ""
  }
}
